# Local-only database. Use a separate restricted application user when deployed.
DATABASE_URL=postgresql://rally:rally_local_only@127.0.0.1:55432/rally
# Sandbox only. The adapter has no live endpoint setting.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Three distinct sandbox personal payer IDs. No passwords belong in this file.
PAYPAL_BUYER_IDS=

# Managed email identity. Only the client-safe publishable/legacy anon key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Fixed trusted origin for login redirects and same-origin mutations.
APP_ORIGIN=http://localhost:3000
# Free hosted setup only. Local development uses npm run worker.
# Keep this key private; the offline schedule command stores it in Supabase Vault.
RALLY_SETTLEMENT_MODE=worker
RALLY_SETTLEMENT_TRIGGER_KEY=
# Private stable random 32-byte hex key for shared quota identifiers.
# Generate with: openssl rand -hex 32
RALLY_RATE_LIMIT_KEY=

# Server-only managed model access from the official Astropods CLI.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
MODEL_DEFAULT=claude-sonnet-4-6
