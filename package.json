{
  "name": "rally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "sandbox": "node --env-file-if-exists=.env.local --import tsx scripts/sandbox.ts",
    "test:mutations": "tsx scripts/check-mutations.ts"
    ,"worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts"
  },
  "dependencies": { "pg": "8.23.1", "zod": "4.6.5" },
  "devDependencies": { "tsx": "4.23.15", "typescript": "7.0.2", "@types/node": "^25.0.0", "@types/pg": "^8.15.0" }
}
