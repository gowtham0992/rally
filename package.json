{
  "name": "rally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "sandbox": "node --env-file-if-exists=.env.local --import tsx scripts/sandbox.ts",
    "test:mutations": "tsx scripts/check-mutations.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "sandbox:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-sandbox.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "ai:evaluate": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-ai.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
